<Window x:Class="GasStationApp.UI.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Оператор" Height="800" Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="#FFB6D2D0">

    <Grid Background="#FFD8EAE8" Margin="10">
        <TextBlock Text="Оператор"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="10,10,0,0"/>
        <Button Content="Вийти"
                Width="100" Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Background="#FFB6D2D0"
                BorderBrush="#FF728C8A"
                BorderThickness="2"
                FontSize="14"
                Click="BtnLogOut_Click"/>
        <TabControl Margin="10,55,10,10" Background="#FFD8EAE8">
            <TabItem Header="Продаж палива">
                <Grid Margin="10">
                    <TextBlock Text="Тип палива:" FontSize="14"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,10,0,0"/>
                    <ComboBox x:Name="CmbFuelType" Width="200" Height="30" FontSize="14"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Margin="100,7,0,0"/>
                    <TextBlock Text="Кількість (л):" FontSize="14"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,55,0,0"/>
                    <TextBox x:Name="TxtLiters" Width="100" Height="30" FontSize="14"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="110,52,0,0" Padding="4,4"/>
                    <TextBlock Text="Номер картки:" FontSize="14"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,100,0,0"/>
                    <TextBox x:Name="TxtSaleCardNumber" Width="160" Height="30" FontSize="14"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="115,97,0,0" Padding="4,4"/>
                    <TextBlock Text="Списати бонусів:" FontSize="14"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,145,0,0"/>
                    <TextBox x:Name="TxtRedeemAmount" Width="100" Height="30" FontSize="14"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="130,142,0,0" Padding="4,4"/>
                    <Button Content="Провести продаж" Width="160" Height="34" FontSize="14"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="0,190,0,0"
                            Background="#FFB6D2D0" BorderBrush="#FF728C8A" BorderThickness="2"
                            Click="BtnMakeSale_Click"/>
                    <TextBlock x:Name="TxtSaleMessage" FontSize="13"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,235,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem Header="Ціни та залишки">
                <Grid Margin="10">
                    <DataGrid x:Name="DgTanksOperator"
                              Height="400"
                              VerticalAlignment="Top"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="50"/>
                            <DataGridTextColumn Header="Паливо" Binding="{Binding FuelType.Name}" Width="130"/>
                            <DataGridTextColumn Header="Ціна (грн/л)" Binding="{Binding FuelType.PricePerLiter}" Width="120"/>
                            <DataGridTextColumn Header="Залишок (л)" Binding="{Binding CurrentLevel}" Width="110"/>
                            <DataGridTextColumn Header="Місткість (л)" Binding="{Binding Capacity}" Width="110"/>
                            <DataGridTextColumn Header="%" Binding="{Binding FillPercentage, StringFormat={}{0:F1}}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Бонусна картка">
                <Grid Margin="10">
                    <TextBlock Text="Номер картки:" FontSize="14"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,10,0,0"/>
                    <TextBox x:Name="TxtFindCard" Width="160" Height="30" FontSize="14"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="120,7,0,0" Padding="4,4"/>
                    <Button Content="Знайти" Width="90" Height="30" FontSize="14"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="295,7,0,0"
                            Background="#FFB6D2D0" BorderBrush="#FF728C8A" BorderThickness="2"
                            Click="BtnFindClient_Click"/>
                    <TextBlock x:Name="TxtClientInfo" FontSize="14"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,50,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtCardMessage" FontSize="13" Foreground="Red"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,170,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem Header="Мій звіт">
                <Grid Margin="10">
                    <Button Content="Сформувати звіт за зміну"
                            Width="220" Height="36" FontSize="14"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="0,10,0,0"
                            Background="#FFB6D2D0" BorderBrush="#FF728C8A" BorderThickness="2"
                            Click="BtnShiftReport_Click"/>
                    <TextBlock x:Name="TxtShiftReport" FontSize="15"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="0,60,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>